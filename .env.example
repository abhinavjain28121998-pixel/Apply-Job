# Job Provider Configuration
# Set to 'naukri' for production, 'mock' for development/demo
JOB_PROVIDER=mock

# Naukri API Configuration (Optional: Only required if JOB_PROVIDER=naukri)
# NAUKRI_API_BASE_URL=
# NAUKRI_API_KEY=
# NAUKRI_CLIENT_ID=
# NAUKRI_CLIENT_SECRET=

# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Firebase Server-Side Admin Authentication Configuration
# Set ALLOW_DEMO_AUTH=true ONLY for local/demo testing. Disabled by default in production.
ALLOW_DEMO_AUTH=false
# Exact demo authentication token (For local/demo testing only; used when ALLOW_DEMO_AUTH=true)
DEMO_AUTH_TOKEN=
FIREBASE_PROJECT_ID=
# Optional Service Account Credentials (if not using Application Default Credentials / GCP metadata)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_KEY=
