# LinkedIn OAuth / OpenID Connect Configuration
LINKEDIN_ENABLED=true
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://apply-jobs-brown.vercel.app/api/linkedin/auth/callback
LINKEDIN_SCOPES=openid profile email

# Gemini AI API Key (Server-side only)
GEMINI_API_KEY=

# Job Provider Configuration (Default: linkedin)
JOB_PROVIDER=linkedin

# Firebase Server-Side Admin Authentication Configuration
# Set ALLOW_DEMO_AUTH=true ONLY for local/demo testing. Disabled by default in production.
ALLOW_DEMO_AUTH=false
# Exact demo authentication token (For local/demo testing only; used when ALLOW_DEMO_AUTH=true)
DEMO_AUTH_TOKEN=
FIREBASE_PROJECT_ID=
# Optional Service Account Credentials (if not using Application Default Credentials / GCP metadata)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_KEY=

# LinkedIn Integration Compliance:
# Official LinkedIn external search destination via https://www.linkedin.com/jobs/search/ URLs.
# No scraping, no Puppeteer, no browser automation, no cookies, and no stored LinkedIn passwords.
